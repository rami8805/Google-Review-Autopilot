rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny all unlisted paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'ouaretchoayb@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isUser(userId) || isAdmin();
      allow create: if isUser(userId) && request.resource.data.identitySubject == request.auth.uid;
      allow update: if (isUser(userId) || isAdmin()) && request.resource.data.identitySubject == resource.data.identitySubject;
      allow delete: if isAdmin();
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Tenant Scoped Collections
    match /tenants/{tenantId} {
      allow read: if isSignedIn() && (
        exists(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid)) ||
        isAdmin()
      );
      allow write: if isAdmin();

      // Tenant Members subcollection
      match /members/{memberId} {
        allow read: if isSignedIn() && (
          request.auth.uid == memberId ||
          exists(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid)) ||
          isAdmin()
        );
        allow write: if isAdmin();
      }

      // Business Locations
      match /locations/{locationId} {
        allow read: if isSignedIn() && (
          exists(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid)) ||
          isAdmin()
        );
        allow write: if isSignedIn() && (
          exists(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid)) ||
          isAdmin()
        );
      }

      // Reviews
      match /reviews/{reviewId} {
        allow read: if isSignedIn() && (
          exists(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid)) ||
          isAdmin()
        );
        allow write: if isSignedIn() && (
          exists(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid)) ||
          isAdmin()
        );
      }

      // Replies
      match /replies/{replyId} {
        allow read: if isSignedIn() && (
          exists(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid)) ||
          isAdmin()
        );
        allow write: if isSignedIn() && (
          exists(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid)) ||
          isAdmin()
        );
      }

      // Rules
      match /rules/{ruleId} {
        allow read: if isSignedIn() && (
          exists(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid)) ||
          isAdmin()
        );
        allow write: if isSignedIn() && (
          exists(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid)) ||
          isAdmin()
        );
      }

      // Brand Voice
      match /brand_voice/{voiceId} {
        allow read: if isSignedIn() && (
          exists(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid)) ||
          isAdmin()
        );
        allow write: if isSignedIn() && (
          exists(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid)) ||
          isAdmin()
        );
      }

      // Subscriptions
      match /subscriptions/{subId} {
        allow read: if isSignedIn() && (
          exists(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid)) ||
          isAdmin()
        );
        allow write: if isAdmin();
      }

      // Support Tickets
      match /tickets/{ticketId} {
        allow read: if isSignedIn() && (
          exists(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid)) ||
          isAdmin()
        );
        allow create: if isSignedIn() && (
          exists(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid)) ||
          isAdmin()
        );
        allow update, delete: if isSignedIn() && (
          exists(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid)) ||
          isAdmin()
        );

        match /messages/{messageId} {
          allow read: if isSignedIn() && (
            exists(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid)) ||
            isAdmin()
          );
          allow create: if isSignedIn() && (
            exists(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid)) ||
            isAdmin()
          );
        }
      }

      // Notifications
      match /notifications/{notifId} {
        allow read: if isSignedIn() && (
          exists(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid)) ||
          isAdmin()
        );
        allow update: if isSignedIn() && (
          exists(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid)) ||
          isAdmin()
        );
        allow create, delete: if isAdmin();
      }

      // Audit Events
      match /audit_events/{eventId} {
        allow read: if isSignedIn() && (
          exists(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid)) ||
          isAdmin()
        );
        allow create: if isSignedIn();
        allow update, delete: if false;
      }
    }
  }
}
