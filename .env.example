# Application
APP_BASE_URL=http://localhost:3000
NODE_ENV=development
PORT=3000
VITE_API_BASE_URL=
VITE_APP_NAME=Google Review Autopilot

# Google Identity Platform / Firebase Auth
FIREBASE_API_KEY=
GOOGLE_IDENTITY_PROJECT_ID=
VITE_GOOGLE_CLIENT_ID=

# Google Business Profile OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/connect-callback
GOOGLE_BUSINESS_SCOPES=https://www.googleapis.com/auth/business.manage

# Token encryption at rest (REQUIRED in production, >= 32 chars)
TOKEN_ENCRYPTION_KEY=

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Paddle Billing (Sandbox)
PADDLE_API_KEY=
PADDLE_BASE_URL=https://sandbox-api.paddle.com
PADDLE_WEBHOOK_SECRET=
VITE_PADDLE_CLIENT_TOKEN=

# Cloud SQL / PostgreSQL
# Prefer DATABASE_URL or Cloud SQL Unix socket in production
DATABASE_URL=
SQL_HOST=127.0.0.1
SQL_PORT=5432
SQL_USER=postgres
SQL_PASSWORD=
SQL_DB_NAME=google_review_autopilot
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=
INSTANCE_CONNECTION_NAME=

# Connection pool tuning
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_QUERY_TIMEOUT_MS=10000

# Google Cloud Tasks (background jobs)
CLOUD_TASKS_PROJECT_ID=
CLOUD_TASKS_LOCATION=us-central1
CLOUD_TASKS_QUEUE_NAME=review-sync
CLOUD_TASKS_SERVICE_ACCOUNT_EMAIL=
