# Runtime
PORT=3000
NODE_ENV=production
APP_BASE_URL=https://your-cloud-run-domain.run.app

# Google Cloud SQL (PostgreSQL)
SQL_HOST=127.0.0.1
SQL_DB_NAME=google_review_autopilot
SQL_USER=app_user
SQL_PASSWORD=
SQL_ADMIN_USER=admin_user
SQL_ADMIN_PASSWORD=

# Google Identity Platform & Business Profile OAuth
GOOGLE_IDENTITY_PROJECT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_BUSINESS_SCOPES=https://www.googleapis.com/auth/business.manage

# Google Gemini AI Safety & Reply Engine
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Paddle Billing Sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_BASE_URL=https://sandbox-api.paddle.com
VITE_PADDLE_CLIENT_TOKEN=test_

# Google Cloud Tasks (Background Processing)
CLOUD_TASKS_PROJECT_ID=
CLOUD_TASKS_LOCATION=us-central1
CLOUD_TASKS_QUEUE_NAME=review-processing-queue
CLOUD_TASKS_SERVICE_ACCOUNT_EMAIL=

# Client Application Variables
VITE_API_BASE_URL=
VITE_APP_NAME=Google Review Autopilot
VITE_GOOGLE_CLIENT_ID=
