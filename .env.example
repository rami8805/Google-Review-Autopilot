# ==============================================================================
# Google Review Autopilot — Environment Configuration Template
# Target: Cloud Run + Firebase Firestore + Google Business Profile + Gemini + Cloud Tasks + Paddle
# Note: Sensitive secrets must be provided via Google Secret Manager in production.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application
# ------------------------------------------------------------------------------
# Canonical HTTPS base URL of the deployed application (used for OAuth redirects & task audience)
APP_BASE_URL=

# ------------------------------------------------------------------------------
# Firebase / Frontend
# ------------------------------------------------------------------------------
# Frontend Firebase Web SDK configuration is loaded from firebase-applet-config.json.
# Backend Firebase Admin SDK uses Google Cloud Run Application Default Credentials (ADC).

# ------------------------------------------------------------------------------
# Google Business Profile
# ------------------------------------------------------------------------------
# Google OAuth 2.0 Client credentials for Google Business Profile API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Optional OAuth scopes override (defaults to https://www.googleapis.com/auth/business.manage)
GOOGLE_BUSINESS_SCOPES=

# ------------------------------------------------------------------------------
# Gemini
# ------------------------------------------------------------------------------
# Google Gemini API key for safe AI review reply generation
GEMINI_API_KEY=
# Optional model override (defaults to gemini-3.8-flash)
GEMINI_MODEL=

# ------------------------------------------------------------------------------
# Cloud Tasks
# ------------------------------------------------------------------------------
# Expected Google Cloud Tasks OIDC caller service account email
CLOUD_TASKS_SERVICE_ACCOUNT_EMAIL=
# Target worker audience URL (optional; defaults to APP_BASE_URL)
CLOUD_TASKS_WORKER_URL=

# ------------------------------------------------------------------------------
# Paddle
# ------------------------------------------------------------------------------
# Paddle vendor API credentials & webhook HMAC verification secret
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
# API Base URL (defaults to https://sandbox-api.paddle.com)
PADDLE_BASE_URL=
# Environment mode: sandbox or live
PADDLE_ENV=
# Public client token for Paddle.js checkout (frontend-safe)
VITE_PADDLE_CLIENT_TOKEN=
# Price IDs for subscription tiers
PADDLE_PRICE_STARTER_MONTHLY=
PADDLE_PRICE_PRO_MONTHLY=
PADDLE_PRICE_BUSINESS_MONTHLY=

# ------------------------------------------------------------------------------
# Security
# ------------------------------------------------------------------------------
# Server-side AES-256-GCM token encryption key (>= 32 characters) for tokens at rest
TOKEN_ENCRYPTION_KEY=
