# ==============================================================================
# Google Review Autopilot - Environment Configuration
# Target Runtime: Google Cloud Run (Node.js 22) + Firebase / Cloud Firestore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application
# ------------------------------------------------------------------------------
# Canonical HTTPS base URL of the deployed Cloud Run service (e.g. https://service.run.app)
# or local dev origin (http://localhost:3000). Used for OAuth redirects and Cloud Tasks audience.
APP_BASE_URL=
# Runtime environment ('production', 'development', or 'test')
NODE_ENV=
# HTTP port (Cloud Run defaults to 3000 / 8080)
PORT=

# ------------------------------------------------------------------------------
# 2. Firebase / Frontend
# ------------------------------------------------------------------------------
# Client-side Firebase configuration is automatically loaded from firebase-applet-config.json.
# Backend Firebase Admin authenticates natively via Google Application Default Credentials (ADC)
# on Cloud Run without requiring service-account key files.

# ------------------------------------------------------------------------------
# 3. Google Business Profile
# ------------------------------------------------------------------------------
# Google OAuth 2.0 Web Client credentials for Google Business Profile connection
GOOGLE_CLIENT_ID=
# OAuth 2.0 Client Secret (Store in Google Secret Manager in production)
GOOGLE_CLIENT_SECRET=
# Authorized OAuth redirect URI (e.g. https://<your-domain>/onboarding or http://localhost:3000/onboarding)
GOOGLE_REDIRECT_URI=
# Optional OAuth scopes override (defaults to https://www.googleapis.com/auth/business.manage)
GOOGLE_BUSINESS_SCOPES=

# ------------------------------------------------------------------------------
# 4. Gemini
# ------------------------------------------------------------------------------
# Google AI Studio Gemini API Key for review draft generation & safety assessments
# (Store in Google Secret Manager in production)
GEMINI_API_KEY=
# Model alias (optional, defaults to gemini-3.8-flash)
GEMINI_MODEL=

# ------------------------------------------------------------------------------
# 5. Cloud Tasks
# ------------------------------------------------------------------------------
# Dedicated Cloud Tasks worker trigger audience (optional, falls back to APP_BASE_URL)
CLOUD_TASKS_WORKER_URL=
# Service account email attached to Cloud Tasks HTTP push triggers for OIDC verification
CLOUD_TASKS_SERVICE_ACCOUNT_EMAIL=

# ------------------------------------------------------------------------------
# 6. Paddle
# ------------------------------------------------------------------------------
# Paddle Billing API Key (Store in Google Secret Manager in production)
PADDLE_API_KEY=
# Paddle Webhook HMAC-SHA256 Signing Secret (Store in Google Secret Manager in production)
PADDLE_WEBHOOK_SECRET=
# Paddle Base API URL (optional, defaults to https://sandbox-api.paddle.com)
PADDLE_BASE_URL=
# Paddle Client Token for frontend checkout overlay (safe for public/browser exposure)
VITE_PADDLE_CLIENT_TOKEN=

# ------------------------------------------------------------------------------
# 7. Security
# ------------------------------------------------------------------------------
# 32-byte key (64 hex characters or 32 ASCII characters) for AES-256-GCM encryption
# of Google OAuth tokens at rest in the database (Store in Google Secret Manager in production)
TOKEN_ENCRYPTION_KEY=
