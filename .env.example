# ==============================================================================
# Google Review Autopilot - Environment Configuration
# Copy this file to .env for local development. Never commit real secrets.
# ==============================================================================

# Node Environment & Server
NODE_ENV="development"
PORT=3000
APP_URL="http://localhost:3000"

# AI Studio / Gemini API (Injected by runtime or configured server-side)
# Server-side only: never expose GEMINI_API_KEY to Vite client!
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-2.5-flash"

# Google Business Profile / Google OAuth Credentials (Server-side)
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/google/callback"
# Required OAuth Scopes for Google Business Profile Reviews
# https://www.googleapis.com/auth/business.manage
GOOGLE_BUSINESS_SCOPES="https://www.googleapis.com/auth/business.manage"

# Database Configuration (PostgreSQL / Cloud SQL / SQLite)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/review_autopilot"

# Session & JWT Secrets
JWT_SECRET="development-jwt-secret-min-32-chars-long"
SESSION_SECRET="development-session-secret-min-32-chars-long"

# Stripe Billing (Server-side)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_STARTER_PRICE_ID="price_starter_..."
STRIPE_GROWTH_PRICE_ID="price_growth_..."
STRIPE_PRO_PRICE_ID="price_pro_..."

# Notifications / Email (Server-side)
RESEND_API_KEY="re_..."
NOTIFICATION_FROM_EMAIL="alerts@reviewautopilot.com"

# Public Client Env Variables (Vite accessible - MUST NOT CONTAIN SECRETS)
VITE_APP_NAME="Google Review Autopilot"
VITE_API_BASE_URL="/api"
VITE_GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
